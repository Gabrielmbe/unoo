# Copia este archivo a .env para desarrollo local. NUNCA subas .env al repo.
# En Render las variables se definen en el panel (o en render.yaml), no aquí.

# Puerto HTTP/WebSocket. En Render NO lo definas: la plataforma lo inyecta.
PORT=10000

# Interfaz de escucha. Render requiere 0.0.0.0.
HOST=0.0.0.0

# Frecuencia del reloj del servidor (ms). Controla la precisión de los timeouts
# de turno y de la ventana de ¡UNO!. 100 ms es imperceptible y barato.
TICK_MS=100

NODE_ENV=development
